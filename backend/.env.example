# Copy to backend/.env. Every value here has a working default for local development.

# Postgres from docker-compose.yml (note port 5433)
DATABASE_URL=postgresql+psycopg://resumelens:resumelens@localhost:5433/resumelens

# Signs the login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Which LLM runs the scoring graph (all free):
#   mock   - no key, fake answers, for building the UI
#   groq   - free key at https://console.groq.com/keys
#   gemini - free key at https://aistudio.google.com/apikey
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Embeddings: gemini (free key above) or local (no key, simple hashing vectors)
EMBEDDING_PROVIDER=local
